generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Store {
  BLINKIT
  ZEPTO
  INSTAMART
  BIGBASKET
}

enum ItemStatus {
  PENDING
  ORDERED
}

enum ListingSource {
  MANUAL
  LIVE_API
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships    HouseholdMember[]
  itemsAdded     CartItem[]     @relation("AddedBy")
  itemsOrdered   CartItem[]     @relation("OrderedBy")
  listingsChecked ItemListing[] @relation("CheckedBy")
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  // Optional live-pricing integration (quickcommerceapi.com) - a third-party
  // paid API, not official store data. apiKey is never returned to clients.
  qcApiKey  String?
  latitude  Float?
  longitude Float?
  pincode   String?

  members       HouseholdMember[]
  cartItems     CartItem[]
  storeSettings StoreSetting[]
}

model HouseholdMember {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model CartItem {
  id          String     @id @default(cuid())
  householdId String
  name        String
  quantity    String     @default("1")
  note        String?
  status      ItemStatus @default(PENDING)

  orderedStore Store?
  addedById    String
  orderedById  String?
  orderedAt    DateTime?
  createdAt    DateTime @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  addedBy   User          @relation("AddedBy", fields: [addedById], references: [id])
  orderedBy User?         @relation("OrderedBy", fields: [orderedById], references: [id])
  listings  ItemListing[]
}

model ItemListing {
  id      String @id @default(cuid())
  itemId  String
  store   Store
  price   Float
  inStock Boolean @default(true)
  source  ListingSource @default(MANUAL)

  checkedById String
  checkedAt   DateTime @updatedAt

  item      CartItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  checkedBy User     @relation("CheckedBy", fields: [checkedById], references: [id])

  @@unique([itemId, store])
}

model StoreSetting {
  id                   String @id @default(cuid())
  householdId          String
  store                Store
  deliveryFee          Float  @default(25)
  freeDeliveryThreshold Float @default(199)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, store])
}
