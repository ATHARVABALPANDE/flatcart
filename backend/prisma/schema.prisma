generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Store {
  BLINKIT
  ZEPTO
  INSTAMART
  BIGBASKET
  OTHER
}

enum ItemStatus {
  PENDING
  ORDERED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships   HouseholdMember[]
  itemsAdded    CartItem[]        @relation("AddedBy")
  itemsOrdered  CartItem[]        @relation("OrderedBy")
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members   HouseholdMember[]
  cartItems CartItem[]
}

model HouseholdMember {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model CartItem {
  id          String     @id @default(cuid())
  householdId String
  name        String
  quantity    String     @default("1")
  store       Store      @default(OTHER)
  note        String?
  status      ItemStatus @default(PENDING)

  addedById   String
  orderedById String?
  orderedAt   DateTime?
  createdAt   DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  addedBy   User      @relation("AddedBy", fields: [addedById], references: [id])
  orderedBy User?     @relation("OrderedBy", fields: [orderedById], references: [id])
}
